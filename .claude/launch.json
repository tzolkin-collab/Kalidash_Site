{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kalidash-admin",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/admin/node_modules/vite/bin/vite.js", "apps/admin", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "kalidash-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@kalidash/api", "dev"],
      "port": 8080
    },
    {
      "name": "kalidash-site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@kalidash/site", "dev", "--port", "3000"],
      "port": 3000
    },
    {
      "name": "kalidash-archive-site",
      "runtimeExecutable": "node",
      "runtimeArgs": [".archive/v1.0_site/node_modules/next/dist/bin/next", "dev", ".archive/v1.0_site", "--port", "3001"],
      "port": 3001
    }
  ]
}
