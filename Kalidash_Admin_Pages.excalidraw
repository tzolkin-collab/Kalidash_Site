    },
    {
      "id": "hosting_content",
      "type": "text",
      "x": 55, "y": 110, "width": 760, "height": 80,
      "text": "FE Cliente (Next.js) .......... Vercel ..................... $0/mês (Free Tier)\nFE Admin (Vite PWA) ........... Vercel ..................... $0/mês (Free Tier)\nBackend Go + MySQL ............ Vultr São Paulo (NVMe) ..... $5/mês (~R$29)\n─────────────────────────────────────────────────────────────────────\nTOTAL INFRAESTRUTURA:                                       $5/mês (~R$29)",
      "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e1e1e", "roughness": 0, "autoResize": true
    },

