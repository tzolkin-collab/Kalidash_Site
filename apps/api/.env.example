# Credenciais do Banco de Dados Na Nuvem (TiDB, Aiven, PlanetScale)
# Copie este arquivo para .env e coloque a sua URL de conexao real.
# Exemplo TiDB:
# DSN="<usuario>:<senha>@tcp(gateway01.us-east-1.prod.aws.tidbcloud.com:4000)/kalidash?tls=true"

DSN="<COLE_SUA_URL_DO_MYSQL_AQUI>"
PORT=":8080"

# Upload de imagem do blog (Cloudflare R2, compatível com S3). Sem isto, o upload fica
# indisponível (a API sobe normal, só a rota /api/blog/upload responde 503).
# Painel R2: dash.cloudflare.com > R2 > Manage API Tokens (cria a Access Key/Secret aqui) e
# a aba do bucket em si (cria o bucket e liga um domínio próprio ou o acesso r2.dev público).
R2_ACCOUNT_ID="<ID_DA_CONTA_CLOUDFLARE>"
R2_ACCESS_KEY_ID="<ACCESS_KEY_DO_TOKEN_R2>"
R2_SECRET_ACCESS_KEY="<SECRET_KEY_DO_TOKEN_R2>"
R2_BUCKET="kalidash-blog"
# Domínio público de leitura do bucket (custom domain configurado no R2, ou o *.r2.dev) — SEM
# barra no final. É o que fica na frente da chave do objeto na URL salva no artigo.
R2_PUBLIC_URL="<https://cdn.seudominio.com.br OU https://pub-xxxx.r2.dev>"

# Revalidação sob demanda do site: quando um artigo é salvo/excluído, a API avisa o site pra ele
# regenerar /blog e /blog/[slug] na hora. REVALIDATE_SECRET deve ser igual ao do apps/site/.env.
# Sem as duas variáveis nada acontece e o site atualiza pelo revalidate de 60s.
SITE_URL="http://localhost:3000"
REVALIDATE_SECRET="<mesmo valor do site>"
