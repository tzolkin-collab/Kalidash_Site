# Credenciais do Banco de Dados Na Nuvem (TiDB, Aiven, PlanetScale)
# Copie este arquivo para .env e coloque a sua URL de conexao real.
# Exemplo TiDB:
# DSN="<usuario>:<senha>@tcp(gateway01.us-east-1.prod.aws.tidbcloud.com:4000)/kalidash?tls=true"

DSN="<COLE_SUA_URL_DO_MYSQL_AQUI>"
PORT=":8080"

# Upload de imagem do blog (Cloudflare R2, compatível com S3). Sem isto, o upload fica
# indisponível (a API sobe normal, só a rota /api/blog/upload responde 503).
# Painel R2: dash.cloudflare.com > R2 > Manage API Tokens (cria a Access Key/Secret aqui) e
# a aba do bucket em si (cria o bucket e liga um domínio próprio ou o acesso r2.dev público).
R2_ACCOUNT_ID="<ID_DA_CONTA_CLOUDFLARE>"
R2_ACCESS_KEY_ID="<ACCESS_KEY_DO_TOKEN_R2>"
R2_SECRET_ACCESS_KEY="<SECRET_KEY_DO_TOKEN_R2>"
R2_BUCKET="kalidash-blog"
# Domínio público de leitura do bucket (custom domain configurado no R2, ou o *.r2.dev) — SEM
# barra no final. É o que fica na frente da chave do objeto na URL salva no artigo.
R2_PUBLIC_URL="<https://cdn.seudominio.com.br OU https://pub-xxxx.r2.dev>"
# Opcional: troca o endereço do storage (MinIO, S3 ou um servidor de teste). Vazio = o R2 da conta acima.
# R2_ENDPOINT=""
# Passo a passo completo, com os testes de verificação: docs/r2-setup.md

# Revalidação sob demanda do site: quando um artigo é salvo/excluído, a API avisa o site pra ele
# regenerar /blog e /blog/[slug] na hora. REVALIDATE_SECRET deve ser igual ao do apps/site/.env.
# Sem as duas variáveis nada acontece e o site atualiza pelo revalidate de 60s.
SITE_URL="http://localhost:3000"
REVALIDATE_SECRET="<mesmo valor do site>"

# Origens que podem chamar a captura pública de lead (POST /api/public/leads), separadas por vírgula,
# sem barra no final. SITE_URL (acima) já conta. "https://*.vercel.app" libera os ambientes de
# visualização. Sem SITE_URL nem ALLOWED_ORIGINS a rota aceita qualquer origem (só para desenvolvimento).
ALLOWED_ORIGINS="https://kalidash.com.br,https://*.vercel.app"

# Destino da captura pública (POST /api/public/leads) quando CRM_API=1: ela cria um LEAD v2 (sem a flag segue
# criando Oportunidade INBOUND). Sem as três linhas abaixo usa a 1ª etapa do tipo Lead do 1º funil ativo
# (precisa de WORKFLOW_API=1) e a fonte "Site — <source do formulário>".
# PUBLIC_LEAD_PIPELINE_ID=""
# PUBLIC_LEAD_STAGE_ID=""
# PUBLIC_LEAD_SOURCE=""

# Funis, requisitos de etapa, tarefas e o gate de etapa no servidor (docs/api-workflow.md).
# Desligado por padrão. Com 1, a API cria as tabelas Pipeline, PipelineStage, StageRequirement e Task
# na subida (só CREATE TABLE IF NOT EXISTS) e libera /api/pipelines, /api/tasks e /api/gate/check.
# Faça backup do banco antes de ligar em produção.
WORKFLOW_API=""

# Pessoas, empresas e leads do CRM (docs/api-crm.md). Desligado por padrão. Com 1, a API acrescenta
# colunas às tabelas Contact e Company (só ADD COLUMN, nada é alterado) e cria CompanyStakeholder,
# Lead e ChangeLog (histórico); libera /api/crm/people, /companies, /leads e /history. Faça backup antes de ligar.
CRM_API=""
# Chave do CPF das pessoas (AES-256-GCM + HMAC). 32 bytes em hex (64 caracteres) ou base64.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA a perca nem a troque: sem ela os CPFs gravados não são mais legíveis. Sem DATA_KEY o CPF é recusado.
DATA_KEY=""

# Login com Google e perfis Admin/Gerente/Vendedor (docs/auth-study.md, docs/pagesAdmin/settings.md).
# LIGADO por padrão (desde 14/11/2026): sem AUTH_API, ou com qualquer valor que não seja 0/false/off, a API
# cria TeamMember e AuthSession na subida, passa a exigir
# sessão em /api/* (menos as rotas públicas: captura de lead e leitura de artigos publicados), aplica o
# perfil no servidor e restringe o CORS a ALLOWED_ORIGINS (acima; precisa listar a origem do admin).
# Faça backup antes de ligar. Admin e API precisam ficar no MESMO site (ex.: admin.kalidash.com e
# api.kalidash.com), senão o navegador não envia o cookie de sessão.
# Falha fechada: se faltar SESSION_SECRET, ALLOWED_ORIGINS ou as variáveis do Google (abaixo), a API NÃO sobe.
# AUTH_API=0 desliga o login e deixa admin e API ABERTOS (CORS "*"): só em desenvolvimento ou emergência.
AUTH_API=
# Segredo da sessão (32+ caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocá-lo derruba todas as sessões abertas.
SESSION_SECRET=
# Credenciais OAuth do Google Cloud (tipo "Aplicativo da Web"). A URL de redirecionamento cadastrada lá
# precisa ser EXATAMENTE a de GOOGLE_REDIRECT_URL, ex.: https://api.kalidash.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
# Para onde o callback devolve a pessoa depois de entrar (a URL do admin, sem barra no final).
ADMIN_URL=
# Opcional: aceita só contas deste domínio do Google Workspace (ex.: kalidash.com).
GOOGLE_HD=
# Admin raiz (rootDev): a conta central, definida aqui e entregue à Kalidash. É criada na primeira subida e
# volta a ser Admin ativo a CADA subida; pela tela ninguém a rebaixa nem a desativa. (AUTH_BOOTSTRAP_ADMIN
# ainda funciona como nome antigo.)
AUTH_ROOT_ADMIN=
# Opcional: equipe inicial criada como Admin na subida, se ainda não existir ("Nome <email>" ou só o e-mail,
# separados por vírgula). Quem já está na equipe não é alterado, então rebaixar ou desativar pela tela vale.
# Ex.: AUTH_ADMINS=Carol Nunes <carol.nunes@kalidash.com>,Iago Braz <iago.braz@kalidash.com>
AUTH_ADMINS=
# Desenvolvimento, sem Google: AUTH_DEV_LOGIN=1 libera POST /auth/dev/login (só do próprio computador) e
# AUTH_COOKIE_INSECURE=1 permite o cookie em http://localhost. NUNCA em produção.
AUTH_DEV_LOGIN=
AUTH_COOKIE_INSECURE=

# Conexão de LPs (WP2): projetos conectados, chaves do snippet, /connect.js e /api/connect/*. Liga sozinha quando
# CRM_API=1 E AUTH_API=1. Limites opcionais (padrão entre parênteses): tentativas por minuto por IP (10),
# envios por minuto por chave (60) e leituras de configuração por minuto por IP (60). Origens das LPs ficam em
# cada projeto (Projetos > Conectar projeto), não aqui.
CONNECT_RATE_IP=
CONNECT_RATE_TOKEN=
CONNECT_RATE_CONFIG=

# Conversões pelo servidor (tracking.go). Cada lead do site carrega um event_id: a tabela TrackingEvent (criada
# na subida, tabela nova) garante 1 lead e 1 conversão por envio, mesmo com clique duplo ou nova tentativa.
# Meta, API de Conversões: o mesmo event_id do Pixel do navegador, a Meta junta os dois e conta 1 Lead.
# Gerenciador de Eventos > conjunto de dados (Pixel) > Configurações > API de Conversões > Gerar token.
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
# Só para validar na aba "Testar eventos" do Gerenciador de Eventos. APAGUE depois do teste.
META_TEST_EVENT_CODE=""
# GA4, Measurement Protocol: com as duas preenchidas, generate_lead sai SÓ daqui (o site deixa de disparar pelo gtag).
# GA4 > Admin > Fluxos de dados > (fluxo) > Chaves secretas da API do Measurement Protocol > Criar.
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""
# Conversões offline (offline_conversions.go): lead qualificado vira QualifiedLead na Meta e qualify_lead no GA4; oportunidade
# em etapa Ganha vira Purchase (com o valor) e close_convert_lead. Liga sozinho com a Meta ou o GA4 acima configurados, só
# para leads INBOUND e fora do modo de teste, uma vez por lead e por etapa. Os dados de correspondência (IP e navegador do
# envio) ficam no lead em customData.match. 0 desliga só esta parte.
OFFLINE_CONVERSIONS=

# E-mail pelo Resend (resend.com). A chave serve ao envio de teste dos modelos (emails.go) e à newsletter.
# Resend > API Keys > Create API Key (permissão "Full access": a newsletter cria contatos).
RESEND_API_KEY=""
# Remetente do envio de teste; o domínio precisa estar verificado em Resend > Domains.
RESEND_FROM_EMAIL=""
# Newsletter do blog (newsletter_resend.go): cada inscrição do site vira lead no CRM e também contato no Resend,
# neste segmento. As edições saem do admin (Newsletter → Edições) pelo Resend Broadcasts, com o descadastro do Resend.
# Resend > Audience > Segments > crie "Newsletter do blog" e copie o id. Vazio: nada vai para o Resend.
RESEND_NEWSLETTER_SEGMENT_ID=""
# Opcional: segmento de quem pediu um material gratuito nos guias do blog (entra nos dois segmentos).
RESEND_MATERIAL_SEGMENT_ID=""
# Opcional: segmento só com a equipe. Aparece como público "Teste (só a equipe)" nas edições da newsletter, para
# ver a edição chegando como broadcast de verdade antes de mandar para a lista.
RESEND_TEST_SEGMENT_ID=""

# E-mails automáticos no servidor (email_automations.go): fluxos prontos que se ligam e desligam em Automações →
# E-mails automáticos, modelos em E-mails e uma fila no MySQL enviada por um worker, com nova tentativa progressiva.
# Desligado por padrão. Com 1, a API cria EmailTemplate, EmailAutomation e EmailJob na subida (só CREATE TABLE IF NOT
# EXISTS) e libera /api/email/*. Usa RESEND_API_KEY e RESEND_FROM_EMAIL (acima); sem elas os e-mails ficam na fila.
EMAIL_AUTOMATIONS=""
# Opcional: endereço de resposta dos e-mails automáticos e intervalo do worker em segundos (padrão 20).
EMAIL_REPLY_TO=""
EMAIL_WORKER_SECONDS=""
