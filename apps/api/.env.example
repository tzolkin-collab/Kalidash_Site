# Credenciais do Banco de Dados Na Nuvem (TiDB, Aiven, PlanetScale)
# Copie este arquivo para .env e coloque a sua URL de conexao real.
# Exemplo TiDB:
# DSN="<usuario>:<senha>@tcp(gateway01.us-east-1.prod.aws.tidbcloud.com:4000)/kalidash?tls=true"

DSN="<COLE_SUA_URL_DO_MYSQL_AQUI>"
PORT=":8080"

# Upload de imagem do blog (Cloudflare R2, compatível com S3). Sem isto, o upload fica
# indisponível (a API sobe normal, só a rota /api/blog/upload responde 503).
# Painel R2: dash.cloudflare.com > R2 > Manage API Tokens (cria a Access Key/Secret aqui) e
# a aba do bucket em si (cria o bucket e liga um domínio próprio ou o acesso r2.dev público).
R2_ACCOUNT_ID="<ID_DA_CONTA_CLOUDFLARE>"
R2_ACCESS_KEY_ID="<ACCESS_KEY_DO_TOKEN_R2>"
R2_SECRET_ACCESS_KEY="<SECRET_KEY_DO_TOKEN_R2>"
R2_BUCKET="kalidash-blog"
# Domínio público de leitura do bucket (custom domain configurado no R2, ou o *.r2.dev) — SEM
# barra no final. É o que fica na frente da chave do objeto na URL salva no artigo.
R2_PUBLIC_URL="<https://cdn.seudominio.com.br OU https://pub-xxxx.r2.dev>"
# Opcional: troca o endereço do storage (MinIO, S3 ou um servidor de teste). Vazio = o R2 da conta acima.
# R2_ENDPOINT=""
# Passo a passo completo, com os testes de verificação: docs/r2-setup.md

# Revalidação sob demanda do site: quando um artigo é salvo/excluído, a API avisa o site pra ele
# regenerar /blog e /blog/[slug] na hora. REVALIDATE_SECRET deve ser igual ao do apps/site/.env.
# Sem as duas variáveis nada acontece e o site atualiza pelo revalidate de 60s.
SITE_URL="http://localhost:3000"
REVALIDATE_SECRET="<mesmo valor do site>"

# Origens que podem chamar a captura pública de lead (POST /api/public/leads), separadas por vírgula,
# sem barra no final. SITE_URL (acima) já conta. "https://*.vercel.app" libera os ambientes de
# visualização. Sem SITE_URL nem ALLOWED_ORIGINS a rota aceita qualquer origem (só para desenvolvimento).
ALLOWED_ORIGINS="https://kalidash.com.br,https://*.vercel.app"

# Funis, requisitos de etapa, tarefas e o gate de etapa no servidor (docs/api-workflow.md).
# Desligado por padrão. Com 1, a API cria as tabelas Pipeline, PipelineStage, StageRequirement e Task
# na subida (só CREATE TABLE IF NOT EXISTS) e libera /api/pipelines, /api/tasks e /api/gate/check.
# Faça backup do banco antes de ligar em produção.
WORKFLOW_API=""

# Pessoas, empresas e leads do CRM (docs/api-crm.md). Desligado por padrão. Com 1, a API acrescenta
# colunas às tabelas Contact e Company (só ADD COLUMN, nada é alterado) e cria CompanyStakeholder,
# Lead e ChangeLog (histórico); libera /api/crm/people, /companies, /leads e /history. Faça backup antes de ligar.
CRM_API=""
# Chave do CPF das pessoas (AES-256-GCM + HMAC). 32 bytes em hex (64 caracteres) ou base64.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA a perca nem a troque: sem ela os CPFs gravados não são mais legíveis. Sem DATA_KEY o CPF é recusado.
DATA_KEY=""

# Login com Google e perfis Admin/Gerente/Vendedor (docs/auth-study.md, docs/pagesAdmin/settings.md).
# Desligado por padrão. Com AUTH_API=1 a API cria TeamMember e AuthSession na subida, passa a exigir
# sessão em /api/* (menos as rotas públicas: captura de lead e leitura de artigos publicados), aplica o
# perfil no servidor e restringe o CORS a ALLOWED_ORIGINS (acima; precisa listar a origem do admin).
# Faça backup antes de ligar. Admin e API precisam ficar no MESMO site (ex.: admin.kalidash.com e
# api.kalidash.com), senão o navegador não envia o cookie de sessão.
AUTH_API=
# Segredo da sessão (32+ caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocá-lo derruba todas as sessões abertas.
SESSION_SECRET=
# Credenciais OAuth do Google Cloud (tipo "Aplicativo da Web"). A URL de redirecionamento cadastrada lá
# precisa ser EXATAMENTE a de GOOGLE_REDIRECT_URL, ex.: https://api.kalidash.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
# Para onde o callback devolve a pessoa depois de entrar (a URL do admin, sem barra no final).
ADMIN_URL=
# Opcional: aceita só contas deste domínio do Google Workspace (ex.: kalidash.com).
GOOGLE_HD=
# E-mail da primeira conta Admin. Só vale enquanto não existir nenhum Admin ativo; depois é ignorado.
AUTH_BOOTSTRAP_ADMIN=
# Desenvolvimento, sem Google: AUTH_DEV_LOGIN=1 libera POST /auth/dev/login (só do próprio computador) e
# AUTH_COOKIE_INSECURE=1 permite o cookie em http://localhost. NUNCA em produção.
AUTH_DEV_LOGIN=
AUTH_COOKIE_INSECURE=
