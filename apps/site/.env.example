# URL da API em Go (server-side).
API_URL="http://localhost:8080"

# Origens do admin autorizadas a embutir /preview/* e a conversar com ele por postMessage
# (separadas por vírgula, sem barra no final). Em produção: a URL pública do admin.
NEXT_PUBLIC_ADMIN_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Segredo que a API em Go usa pra pedir revalidação de /blog e /blog/[slug] (POST /api/revalidate).
# Precisa ser o MESMO valor de REVALIDATE_SECRET no .env da API. Sem ele o endpoint fica desligado
# e o site só atualiza pelo revalidate de 60s.
REVALIDATE_SECRET="<gere com: node -e \"console.log(require('crypto').randomBytes(24).toString('hex'))\">"

# URL pública da API para o formulário da Home (o navegador chama direto). Ex.: https://api.seudominio.com.br/api/public/leads
# Vazio = o formulário valida e avisa que o envio não está conectado.
NEXT_PUBLIC_LEAD_ENDPOINT=""
