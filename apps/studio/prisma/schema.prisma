generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// CRM CORE - Simples, Funcional e Visual
// ==========================================

model Opportunity {
  id          String   @id @default(uuid())
  title       String   // Nome da oportunidade (ex: "Consultoria de Vendas")
  value       Float?   // Valor monetário (ex: 5000.00)
  
  // Visual e Organização
  stage       String   @default("INBOUND") // INBOUND, QUALIFICATION, PROPOSAL, NEGOTIATION, WON, LOST
  priority    String   @default("MEDIUM")  // LOW, MEDIUM, HIGH (Para mostrar badges coloridos)
  tags        Json?    // Array de strings (ex: ["Indicação", "Enterprise"])
  
  // Relacionamentos Diretos (1 Oportunidade = 1 Empresa + 1 Contato Principal)
  companyId   String?  // Opcional!
  company     Company? @relation(fields: [companyId], references: [id])
  
  contactId   String?  // Opcional!
  contact     Contact? @relation(fields: [contactId], references: [id])
  
  // Membro da Equipe Kalidash (Dono da Oportunidade)
  ownerId     String?  // Opcional por enquanto
  owner       User?    @relation(fields: [ownerId], references: [id])
  
  notes       Note[]   // Histórico de interações
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Note {
  id            String      @id @default(uuid())
  content       String      @db.Text
  type          String      @default("NOTE") // NOTE, CALL, EMAIL, MEETING, TASK
  
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  authorId      String?
  author        User?       @relation(fields: [authorId], references: [id])
  
  createdAt     DateTime    @default(now())
}

model User {
  id          String   @id @default(uuid())
  name        String   // Ex: "Carol Sales"
  email       String   @unique
  avatarUrl   String?  // Foto de perfil do membro da equipe
  role        String   @default("MEMBER") // ADMIN, MEMBER
  
  // Oportunidades sob responsabilidade deste usuário
  opportunities Opportunity[]
  notes         Note[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Company {
  id          String   @id @default(uuid())
  name        String   // Nome da empresa
  logoUrl     String?  // Para a interface ficar linda (ex: ícone da empresa)
  website     String?
  
  opportunities Opportunity[]
  contacts      Contact[]
}

model Contact {
  id          String   @id @default(uuid())
  name        String   // Nome da pessoa
  email       String?
  phone       String?
  avatarUrl   String?  // Foto da pessoa (Visual)
  
  companyId   String?  // Opcional! Se for pessoa física, fica nulo.
  company     Company? @relation(fields: [companyId], references: [id])
  
  opportunities Opportunity[]
}
