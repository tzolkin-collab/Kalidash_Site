# ==============================================================================
# KALIDASH ADMIN (apps/admin) — VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Este arquivo contém as variáveis do painel administrativo (Vite + React PWA).
# Copie este modelo para apps/admin/.env.local (ou .env no servidor/Vercel).
# ==============================================================================

# URL pública da API em Go (onde o Admin faz as chamadas autenticadas)
# Local: http://localhost:8080 | Produção: https://api.kalidash.com
VITE_API_URL="https://api.kalidash.com"

# Somente para ambiente de desenvolvimento:
# Com a API ligada e o banco vazio, grava dados de exemplo na primeira inicialização.
# Deixe em branco em homologação e produção.
VITE_SEED_DEMO=""
