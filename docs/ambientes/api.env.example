# ==============================================================================
# KALIDASH API (apps/api) — VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Este arquivo contém todas as variáveis necessárias para o backend em Go da Kalidash.
# Copie este modelo para apps/api/.env no seu ambiente local ou servidor.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR E BANCO DE DADOS
# ------------------------------------------------------------------------------
# Porta onde o servidor Go escuta requisições HTTP (padrão :8080)
PORT=":8080"

# String de conexão do MySQL (TiDB, PlanetScale, Aiven ou local).
# Formato: usuario:senha@tcp(host:porta)/database?parseTime=true&tls=true
DSN="usuario:senha@tcp(gateway.us-east-1.prod.tidbcloud.com:4000)/kalidash?tls=true"

# Chave criptográfica para proteção de dados sensíveis (CPF) via AES-256-GCM + HMAC.
# Deve ter exatamente 32 bytes em hexadecimal (64 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY="coloque_aqui_64_caracteres_hex_aleatorios"

# ------------------------------------------------------------------------------
# 2. FLAGS DE MÓDULOS (LIGAR FUNCIONALIDADES EM PRODUÇÃO)
# ------------------------------------------------------------------------------
# Liga o motor de funis, requisitos e tarefas (docs/api-workflow.md). Valor: 1
WORKFLOW_API=1

# Liga o motor de pessoas, empresas e leads do CRM (docs/api-crm.md). Valor: 1
CRM_API=1

# Liga a autenticação por sessão, Google Workspace e RBAC (docs/auth-study.md). Valor: 1
AUTH_API=1

# ------------------------------------------------------------------------------
# 3. SEGURANÇA, CORS E REVALIDAÇÃO
# ------------------------------------------------------------------------------
# Segredo da sessão do cookie HttpOnly (32+ caracteres). Trocá-lo derruba todas as sessões.
SESSION_SECRET="coloque_aqui_um_segredo_de_sessao_muito_seguro_e_longo"

# Origens autorizadas para chamadas autenticadas do Admin e captura de leads do site.
# Separadas por vírgula, sem barra no final.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://kalidash.com,https://app.kalidash.com"

# URL do site para revalidação sob demanda do blog (Next.js ISR).
SITE_URL="https://kalidash.com"

# Segredo de revalidação sob demanda (deve ser idêntico ao REVALIDATE_SECRET do site).
REVALIDATE_SECRET="coloque_aqui_o_mesmo_segredo_hex_do_site"

# ------------------------------------------------------------------------------
# 4. GOOGLE WORKSPACE SSO (AUTENTICAÇÃO DOS COLABORADORES)
# ------------------------------------------------------------------------------
# Credenciais do Google Cloud Console (OAuth 2.0 Web Client)
GOOGLE_CLIENT_ID="seu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-client-secret"

# URL de callback da API cadastrada no Google Cloud Console
GOOGLE_REDIRECT_URL="https://api.kalidash.com/auth/google/callback"

# URL para onde o callback redireciona o colaborador após o login com sucesso (o Admin)
ADMIN_URL="https://app.kalidash.com"

# Domínio do Google Workspace permitido (restringe logins exclusivamente a colaboradores)
GOOGLE_HD="kalidash.com"

# E-mail do Administrador Raiz inicial (recebe perfil ADMIN na primeira subida)
AUTH_ROOT_ADMIN="admin@kalidash.com"

# Flags de desenvolvimento local (NUNCA ATIVAR EM PRODUÇÃO):
# AUTH_DEV_LOGIN=1
# AUTH_COOKIE_INSECURE=1

# ------------------------------------------------------------------------------
# 5. GOOGLE ANALYTICS 4 DATA API (MÉTRICAS NO ADMIN — WORKSPACE KALIDASH)
# ------------------------------------------------------------------------------
# ID numérico da Propriedade no GA4 da Kalidash (Admin > Detalhes da Propriedade)
GA4_PROPERTY_ID="123456789"

# E-mail da Service Account criada no Google Cloud da Kalidash
# (Este e-mail deve receber permissão de 'Leitor' na Propriedade do GA4 acima)
GA4_CLIENT_EMAIL="kalidash-analytics@seu-projeto-gcp.iam.gserviceaccount.com"

# Chave privada da Service Account (formato PEM completo, com quebras de linha \n)
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 5.1. GA4 MEASUREMENT PROTOCOL & META CONVERSIONS API (DISPAROS SERVER-SIDE)
# ------------------------------------------------------------------------------
# Opcional: permite ao backend disparar conversões offline/qualificadas diretamente para o GA4 e Meta Ads
# Chave de API do Measurement Protocol (GA4 > Administrador > Fluxos de Dados > Segredos da API do Measurement Protocol)
GA4_API_SECRET="seu_api_secret_do_ga4"
GA4_MEASUREMENT_ID="G-XXXXXXXXXX"

# Token de Acesso do Gerenciador de Eventos da Meta (Usuário do Sistema com permissão no Pixel)
META_CAPI_ACCESS_TOKEN="EAAG..."
META_PIXEL_ID="123456789012345"
# META_TEST_EVENT_CODE="TEST12345" # Usado apenas para validar eventos na aba Testar Eventos do Gerenciador da Meta

# ------------------------------------------------------------------------------
# 6. UPLOAD DE IMAGENS DO BLOG (CLOUDFLARE R2 / S3 COMPATÍVEL)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="id_da_conta_cloudflare"
R2_ACCESS_KEY_ID="access_key_do_token_r2"
R2_SECRET_ACCESS_KEY="secret_key_do_token_r2"
R2_BUCKET="kalidash-blog"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ------------------------------------------------------------------------------
# 7. DISPARO DE E-MAILS TRANSACIONAIS (RESEND)
# ------------------------------------------------------------------------------
# Chave da API do Resend (https://resend.com) usada para envio de e-mails em oportunidades
# e teste de modelos visuais (/api/emails/send e /api/emails/test).
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"

# Remetente dos e-mails enviados pelo CRM (requer domínio kalidash.com.br verificado no Resend).
# Padrão se omitido: "Kalidash CRM <onboarding@resend.dev>"
RESEND_FROM_EMAIL="Kalidash <contato@kalidash.com.br>"

# ------------------------------------------------------------------------------
# 8. CAPTURA PÚBLICA DE LEADS DO SITE (POST /api/public/leads)
# ------------------------------------------------------------------------------
# Opcional: define qual funil e coluna recebem os leads da captura pública do site
# PUBLIC_LEAD_PIPELINE_ID="id_do_funil_inbound"
# PUBLIC_LEAD_STAGE_ID="id_da_etapa_lead"
# PUBLIC_LEAD_SOURCE="Site — Diagnóstico IA"

# ------------------------------------------------------------------------------
# 8. LIMITES DE TAXA DO CONNECT.JS (PROJETOS CONECTADOS)
# ------------------------------------------------------------------------------
CONNECT_RATE_IP=10
CONNECT_RATE_TOKEN=60
CONNECT_RATE_CONFIG=60
