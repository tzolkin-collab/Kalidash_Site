# ==============================================================================
# KALIDASH SITE (apps/site) — VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Este arquivo contém todas as variáveis necessárias para a execução do site
# institucional da Kalidash (Next.js 15 App Router).
# Copie este modelo para apps/site/.env.local (ou .env no servidor).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. COMUNICAÇÃO COM O BACKEND (API GO)
# ------------------------------------------------------------------------------
# URL interna do backend em Go (usada em chamadas server-side, renderização do blog).
API_URL="http://localhost:8080"

# URL pública da API usada pelos formulários do site no navegador do usuário.
# Exemplo em produção: https://api.kalidash.com/api/public/leads
# Se deixado em branco, o formulário valida mas não persiste o envio.
NEXT_PUBLIC_LEAD_ENDPOINT="https://api.kalidash.com/api/public/leads"

# ------------------------------------------------------------------------------
# 2. SEGURANÇA E INTEGRAÇÃO DO BLOG / ADMIN
# ------------------------------------------------------------------------------
# Origens do Admin autorizadas a embutir o /preview/* em iframe e conversar via postMessage.
# Separadas por vírgula, sem barra no final.
NEXT_PUBLIC_ADMIN_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://app.kalidash.com"

# URL pública oficial do site (canonical, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL="https://kalidash.com"

# Segredo de revalidação sob demanda (ISR) do Next.js (POST /api/revalidate).
# Deve ter EXATAMENTE o mesmo valor de REVALIDATE_SECRET no .env da API Go.
REVALIDATE_SECRET="coloque_aqui_um_segredo_hex_aleatorio_32_chars"

# ------------------------------------------------------------------------------
# 3. TRACKING, GOOGLE E META (ANÚNCIOS & ANALYTICS)
# ------------------------------------------------------------------------------
# ID do container do Google Tag Manager (GTM). O GTM orquestra GA4, Google Ads e Meta.
# Formato: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# ID de medição do Google Analytics 4 (GA4). Opcional se já estiver configurado dentro do GTM.
# Formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ID do Pixel da Meta (Facebook / Instagram Ads). Opcional se já estiver configurado no GTM.
# Formato: 15 ou 16 dígitos numéricos
NEXT_PUBLIC_META_PIXEL_ID="123456789012345"

# ID de Conversão do Google Ads (para campanhas de busca, display e Performance Max).
# Formato: AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID="AW-1234567890"

# Rótulo de Conversão do Google Ads para envio de lead (gerado no Google Ads em Metas > Conversões).
# Formato: String alfanumérica de ~19 caracteres (ex: AbCdEfGhIjKlMnOpQrS)
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL="AbCd_EfGhIjKlMnOpQr"
