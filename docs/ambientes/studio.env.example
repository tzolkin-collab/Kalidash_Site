# ==============================================================================
# KALIDASH STUDIO (apps/studio) — VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Utilizado para executar o Prisma Studio e migrações diretas no banco de dados.
# Copie este modelo para apps/studio/.env.
# ==============================================================================

# String de conexão do Prisma com o banco MySQL
# Formato: mysql://usuario:senha@host:porta/banco?sslmode=require
DSN_PRISMA="mysql://usuario:senha@gateway.us-east-1.prod.tidbcloud.com:4000/kalidash?sslmode=require"
